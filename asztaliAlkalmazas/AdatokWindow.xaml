<Window x:Class="asztaliAlkalmazas.AdatokWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:asztaliAlkalmazas"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="AdatokWindow" Height="500" Width="350">
    <Grid>
        <StackPanel>
            <Border Width="140" Height="140" CornerRadius="100" Background="Gray" HorizontalAlignment="Center" Margin="0,20,0,0">
                <TextBlock x:Name="IconText" FontSize="20" Text="Kezdőbetű" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="profilName" Text="Név" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SpeciesText" Text="banda (ha van)"  FontSize="14" HorizontalAlignment="Center"/>

            <Border Padding="14" Margin="0,30,0,0">
                <TextBlock Text="Email, bio, adatok helye" FontSize="16"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>
