@startuml UseCase

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor<<common>> #EFF6FF
    BackgroundColor<<leader>> #FEF3C7
    BackgroundColor<<admin>> #FEE2E2
    BackgroundColor<<member>> #DCFCE7
    BorderColor #666666
}
skinparam actor {
    BackgroundColor<<leader>> #FEF3C7
    BorderColor<<leader>> #D97706
    BackgroundColor<<admin>> #FEE2E2
    BorderColor<<admin>> #DC2626
    BackgroundColor<<user>> #DBEAFE
    BorderColor<<user>> #2563EB
    BackgroundColor<<member>> #DCFCE7
    BorderColor<<member>> #16A34A
}

title BegBand - Use Case diagram

actor "Leader" as Leader <<leader>>
actor "Admin" as Admin <<admin>>
actor "User" as User <<user>>
actor "BandMember" as BandMember <<member>>

rectangle "BegBand" {

    package "Alap funkciók (minden felhasználó)" {
        usecase "Zene keresése" as UC_ZeneKereses <<common>>
        usecase "Bandák keresése" as UC_BandakKereses <<common>>
        usecase "Bandához csatlakozás" as UC_BandaCsatlakozas <<common>>
        usecase "Banda létrehozása" as UC_BandaLetrehozas <<common>>
        usecase "Profil szerkesztése" as UC_ProfilSzerk <<common>>
        usecase "Zene posztolása" as UC_ZenePoszt <<common>>
        usecase "Eseménynaptár megtekintése" as UC_NaptarMegtekintes <<common>>
    }

    package "Tartalom-feed (minden felhasználó)" {
        usecase "Videó posztolása" as UC_VideoPoszt <<common>>
        usecase "Tartalom kedvelése" as UC_TartalomKedveles <<common>>
        usecase "Banda követése" as UC_BandaKovetes <<common>>
        usecase "Feed megtekintése" as UC_FeedMegtekintese <<common>>
    }

    package "Banda- és próbakezelés (Leader)" {
        usecase "Banda kezelése" as UC_BandaKezeles <<leader>>
        usecase "Tagok kezelése" as UC_TagokKezeles <<leader>>
        usecase "Eseménynaptár kezelése" as UC_NaptarKezeles <<leader>>
        usecase "Próba létrehozása" as UC_ProbaLetrehozas <<leader>>
        usecase "Próba kezelése" as UC_ProbaKezeles <<leader>>
        usecase "Koncert létrehozása" as UC_KoncertLetrehozas <<leader>>
    }

    package "Csapat áttekintése (BandMember)" {
        usecase "Banda megtekintése" as UC_BandaMegtekintese <<member>>
        usecase "Tagok megtekintése" as UC_TagokMegtekintese <<member>>
        usecase "Próba megtekintése" as UC_ProbaMegtekintes <<member>>
        usecase "Próba naptár megtekintése" as UC_ProbaNaptárMegtekintes <<member>>
        usecase "Koncert megtekintése" as UC_KoncertMegtekintese <<member>>
    }

    package "Adminisztráció (Admin)" {
        usecase "Userek kezelése" as UC_UserekKezeles <<admin>>
        usecase "Userek törlése" as UC_UserekTorles <<admin>>
        usecase "Mindent tud amit a tobbi rang rendelkezik" as UC_AdminMinden <<admin>>
    }
}

